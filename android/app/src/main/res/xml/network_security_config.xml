<?xml version="1.0" encoding="utf-8"?>
<!-- Mặc định CHẶN mọi kết nối không mã hoá. Chỉ mở ngoại lệ cho địa chỉ
     XML giá vàng chính thức của SJC (nguồn dự phòng khi https trục trặc). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">sjc.com.vn</domain>
    </domain-config>
</network-security-config>
